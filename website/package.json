{
    "name": "blot-website",
    "private": true,
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "typecheck": "tsc --noEmit",
        "format:check": "prettier --config ../app/.prettierrc --check src index.html vite.config.ts tsconfig.json package.json"
    },
    "dependencies": {
        "@fold-ui/core": "^0.26.0",
        "@fold-ui/design": "^0.26.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@types/node": "^20.5.1",
        "@types/react": "^18.2.25",
        "@types/react-dom": "^18.0.11",
        "@vitejs/plugin-react": "^4.0.0",
        "prettier": "^2.8.8",
        "typescript": "~5.9.3",
        "vite": "^4.5.14"
    }
}
