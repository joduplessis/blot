{
    "name": "blot",
    "private": true,
    "version": "2026.11.1",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "npm run build:desktop && node scripts/dev.mjs",
        "dev:ui": "vite --host 127.0.0.1",
        "build:desktop": "npm --prefix desktop run build",
        "typecheck": "tsc --noEmit && npm --prefix desktop run typecheck",
        "build": "npm run typecheck && vite build && npm run build:desktop",
        "preview": "vite preview --host 127.0.0.1",
        "electron": "npm run build && npm --prefix desktop start",
        "pack:mac": "npm run build && npm --prefix desktop run pack:mac",
        "pack:win": "npm run build && npm --prefix desktop run pack:win",
        "pack:linux": "npm run build && npm --prefix desktop run pack:linux",
        "prettier:check": "prettier --check src desktop/src"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.6.13",
        "@fold-ui/core": "^0.27.0",
        "@fold-ui/design": "^0.27.0",
        "@hugeicons/core-free-icons": "^4.4.0",
        "@hugeicons/react": "^1.1.10",
        "@solar-icons/react": "^1.1.1",
        "@tiptap/core": "^3.27.1",
        "@tiptap/extension-highlight": "^3.27.1",
        "@tiptap/extension-placeholder": "^3.27.1",
        "@tiptap/extension-task-item": "^3.27.1",
        "@tiptap/extension-task-list": "^3.27.1",
        "@tiptap/extension-text-align": "^3.27.1",
        "@tiptap/extension-typography": "^3.27.1",
        "@tiptap/pm": "^3.27.1",
        "@tiptap/react": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "chrono-node": "^2.8.4",
        "date-fns": "^2.30.0",
        "date-fns-tz": "^2.0.1",
        "dompurify": "^3.3.0",
        "emoji-picker-react": "^4.12.0",
        "marked": "^14.1.3",
        "parse5": "^7.3.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router": "^6.11.1",
        "react-router-dom": "^6.11.1",
        "rrule": "^2.8.1",
        "zustand": "^5.0.0-rc.2"
    },
    "devDependencies": {
        "@types/node": "^20.5.1",
        "@types/react": "^18.2.25",
        "@types/react-dom": "^18.0.11",
        "@vitejs/plugin-react": "^4.0.0",
        "prettier": "^2.8.8",
        "typescript": "^5.0.2",
        "vite": "^4.3.2"
    },
    "description": "A small, local-first notes app"
}
